{
  "manifest_version": 3,
  "name": "Painting Tab: A museum painting in every new tab",
  "version": "1.0.0",
  "description": "Shows a random painting from a famous museum on every new tab.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://collections.louvre.fr/*",
    "https://collectionapi.metmuseum.org/*",
    "https://data.rijksmuseum.nl/*",
    "https://id.rijksmuseum.nl/*",
    "https://query.wikidata.org/*",
    "https://commons.wikimedia.org/*"
  ]
}
